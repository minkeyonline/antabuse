# Clerk: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Postgres (required in production, e.g. Neon via Vercel → Storage).
# Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=

# Optional: your own RPC endpoints (public RPCs are used when empty).
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=
RPC_URL_POLYGON=
